html
  head
    title Study Buddy
    style.
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: sans-serif; background: #f5f5f5; }
      nav { background: #c0392b; padding: 14px 28px; display: flex; gap: 24px; }
      nav a { color: white; text-decoration: none; font-weight: bold; font-size: 15px; }
      .container { max-width: 960px; margin: 30px auto; padding: 0 20px; }
      .card { background: white; border-radius: 10px; padding: 20px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
      .tag { background: #f0f0f0; color: #555; padding: 4px 10px; border-radius: 12px; margin-right: 6px; font-size: 12px; display: inline-block; margin-bottom: 4px; }
      .btn { background: #c0392b; color: white; padding: 10px 22px; border-radius: 6px; text-decoration: none; font-size: 14px; display: inline-block; }
      a { color: #c0392b; }
      hr { border: none; border-top: 1px solid #eee; margin: 16px 0; }
      h2 { margin-bottom: 16px; }
  body
    nav
      a(href='/users') Users
      a(href='/sessions') Sessions
      a(href='/tags') Tags
    .container
      block content
