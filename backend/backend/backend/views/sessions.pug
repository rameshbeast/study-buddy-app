cat > backend/views/sessions.pug << 'EOF'
extends layout

block content
  h2 Study Sessions
  p(style='color:#666; margin-bottom:20px') #{sessions.length} sessions available

  each session in sessions
    .card
      h3(style='margin-bottom:6px')= session.title
      p(style='font-size:13px; color:#888; margin-bottom:4px') #{session.date}
      p(style='font-size:13px; color:#888; margin-bottom:4px') Location: #{session.location}
      p(style='font-size:13px; color:#666; margin-bottom:8px') By: #{session.author}
      a(href=`/sessions/${session.id}`) View Details →
EOF